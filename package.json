{
  "name": "tianming",
  "version": "1.0.0",
  "description": "TIANMING — Xianxia cultivation Discord bot",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "deploy": "node --env-file=.env src/deploy-commands.js",
    "test": "node --env-file=.env test.js",
    "sim": "node --env-file=.env cli.js sim",
    "db": "node --env-file=.env cli.js db",
