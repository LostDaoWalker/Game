    "card": "node --env-file=.env cli.js card",
    "stats": "node --env-file=.env cli.js stats"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "better-sqlite3": "^11.0.0",
    "@napi-rs/canvas": "^0.1.65"
  }
